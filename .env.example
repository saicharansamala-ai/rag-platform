# Application
APP_NAME=Production RAG Platform
APP_ENV=development
LOG_LEVEL=INFO

# Providers
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=local

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API LLM
OPENAI_API_KEY=

# API embedding
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage
VECTOR_STORE=faiss
DATA_DIR=data
INDEX_DIR=data/indexes